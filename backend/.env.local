# Tracked in this repo on purpose (see .gitignore) - the safe, public
# counterpart to the real, gitignored .env. Every line below is commented
# out: this file is documentation only, showing what .env actually looks
# like with fake values, without any of it being active.
#
# It's deliberately inert rather than a real override: Symfony loads
# .env.local AFTER .env and lets it win for dev/prod, but SKIPS it
# entirely in the test environment - so anything real needed by the app
# (database, JWT, ...) has to live in .env instead, where every
# environment can see it. An uncommented line here would also silently
# override .env's real value in dev, which is never what you want for a
# file that's meant to be safe to publish as-is.

# ###> symfony/framework-bundle ###
# APP_ENV=dev
# APP_SECRET=example_fake_secret_not_the_real_one
# APP_SHARE_DIR=var/share
# ###< symfony/framework-bundle ###

# ###> doctrine/doctrine-bundle ###
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/dbname?serverVersion=16&charset=utf8"
# ###< doctrine/doctrine-bundle ###

# ###> symfony/mailer ###
# MAILER_DSN=null://null
# ###< symfony/mailer ###

# ###> lexik/jwt-authentication-bundle ###
# JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
# JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# JWT_PASSPHRASE=example_fake_passphrase_not_the_real_one
# ###< lexik/jwt-authentication-bundle ###

# ###> nelmio/cors-bundle ###
# CORS_ALLOW_ORIGIN='^http://localhost:3000$'
# ###< nelmio/cors-bundle ###

# ###> app ###
# FRONTEND_URL=http://localhost:3000
# AI_API_KEY=gsk_example_fake_key_for_illustration_only
# AI_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=qwen/qwen3.8-27b
# AZURE_SPEECH_KEY=example_fake_key_for_illustration_only
# AZURE_SPEECH_REGION=westeurope
# ###< app ###
